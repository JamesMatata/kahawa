SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app,.ngrok-free.dev
# Scheme + host. A leading *. trusts every subdomain, so a new ngrok URL still logs in.
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://*.ngrok-free.app,https://*.ngrok-free.dev
SITE_URL=http://127.0.0.1:8000

# SMS — use 'console' locally; 'africastalking' in production with real keys
SMS_PROVIDER=console
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

# KRA eTIMS OSCU. Receipts stay unmarked until these are filled and the device is initialised.
# ETIMS_ENV: sandbox | production
# ETIMS_TIN: KRA PIN. ETIMS_BHF_ID: branch id (00 is head office).
# ETIMS_DEVICE_SERIAL: dvcSrlNo sent once at init. ETIMS_CMC_KEY: communication key returned by that call.
ETIMS_ENV=sandbox
ETIMS_TIN=
ETIMS_BHF_ID=00
ETIMS_DEVICE_SERIAL=
ETIMS_CMC_KEY=

# Cafe / trust details (footer, legal pages, prep ETAs)
CAFE_NAME=Kahawa
CAFE_ADDRESS=Kimathi Street, CBD · Nairobi
CAFE_HOURS_WEEKDAY=Mon–Fri 7:00–21:00
CAFE_HOURS_WEEKEND=Sat–Sun 8:00–22:00
CAFE_PHONE=+254 700 000 000
CAFE_PHONE_TEL=+254700000000
CAFE_WHATSAPP=254700000000
CAFE_MAPS_URL=https://maps.google.com/?q=Kimathi+Street+Nairobi
CAFE_PREP_PICKUP_MIN=10
CAFE_PREP_DELIVERY_MIN=25

# Payment polling timeout (seconds) before STK is treated as failed
PAYMENT_TIMEOUT_SECONDS=90

# M-Pesa Daraja STK Push
# MPESA_MODE: mock (local demo) | live
MPESA_MODE=mock
# MPESA_ENV: sandbox | production (used when MPESA_MODE=live)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Path secret for Daraja callbacks: SITE_URL/mpesa/callback/<secret>/
# Generate a long random string before going live. Leave empty for local mock.
MPESA_CALLBACK_SECRET=
# Optional full override; defaults to SITE_URL + /mpesa/callback/[secret/]
MPESA_CALLBACK_URL=
